  LanId: 3
  LanName: "Th\u1EE7y L\xE2n"
  LanIcon: {fileID: -1266505373287342346, guid: 25fc2fa3b8d7c5c4dba6ebf2dee4aef7, type: 3}
  UnlockCostStar: 800
