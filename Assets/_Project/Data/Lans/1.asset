  skillName: "L\u01B0\u1EDBt nhanh b\u1EA5t t\u1EED"
  skillDescription: "L\xE2n l\u01B0\u1EDBt nhanh v\u1EC1 ph\xEDa tr\u01B0\u1EDBc
    trong 1.5 gi\xE2y, trong th\u1EDDi gian \u0111\xF3 kh\xF4ng nh\u1EADn s\xE1t
    th\u01B0\u01A1ng t\u1EEB b\u1EA5t k\u1EF3 ngu\u1ED3n n\xE0o."
  skillDamage: 0
  skillCooldown: 15
  skillIcon: {fileID: -2125285928806984722, guid: f74bcfb401725c640a1480a3533e759d, type: 3}
  storyDescription: "Kim L\xE2n l\xE0 ho\xE1 th\xE2n \u0111\u1EA7u ti\xEAn v\xE0
    tr\u1EBB nh\u1EA5t trong T\u1EE9 L\xE2n, sinh ra t\u1EEB ti\u1EBFng tr\u1ED1ng
    h\u1ED9i \u0111\u1EA7u ti\xEAn vang l\xEAn \u1EDF s\xE2n \u0111\xECnh l\xE0ng
    \u2014 n\u01A1i nh\u1EEFng \u0111\u1EE9a tr\u1EBB t\u1EADp m\xFAa l\xE2n m\u1ED7i
    m\xF9a Trung Thu. V\xEC th\u1EBF Kim L\xE2n mang h\xECnh h\xE0i th\xE2n thi\u1EC7n,
    ch\u01B0a ho\xE0n thi\u1EC7n s\u1EE9c m\u1EA1nh nguy\xEAn t\u1ED1 nh\u01B0 ba
    ng\u01B0\u1EDDi anh em, nh\u01B0ng b\xF9 l\u1EA1i s\u1EDF h\u1EEFu s\u1EF1 lanh
    l\u1EE3i v\xE0 l\xF2ng d\u0169ng c\u1EA3m c\u1EE7a m\u1ED9t \u0111\u1EE9a tr\u1EBB
    ch\u01B0a t\u1EEBng bi\u1EBFt s\u1EE3 b\xF3ng t\u1ED1i.\n\nKim L\xE2n kh\xF4ng
    ch\u1ECDn phe m\u1EA1nh nh\u1EA5t hay nguy\xEAn t\u1ED1 d\u1EEF d\u1ED9i nh\u1EA5t
    \u2014 c\u1EADu ch\u1ECDn \u1EDF l\u1EA1i tuy\u1EBFn \u0111\u1EA7u, ru ng\u1EE7
    d\xE2n l\xE0ng b\u1EB1ng \xE1nh s\xE1ng d\u1ECBu v\xE0 gi\u1EEF nh\u1ECBp tr\u1ED1ng
    h\u1ED9i kh\xF4ng bao gi\u1EDD t\u1EAFt. K\u1EF9 n\u0103ng \"L\u01B0\u1EDBt nhanh
    b\u1EA5t t\u1EED\" ch\xEDnh l\xE0 b\u1EA3n n\u0103ng c\u1EE7a m\u1ED9t ch\xFA
    l\xE2n nh\u1ECF lao m\xECnh che ch\u1EAFn cho \u0111o\xE0n r\u01B0\u1EDBc \u0111\xE8n,
    b\u1EA5t ch\u1EA5p hi\u1EC3m nguy, d\xF9 ch\u1EC9 trong kho\u1EA3nh kh\u1EAFc."
  titleColor: {r: 0.9607843, g: 0.84313726, b: 0.43137255, a: 1}
  skillTitleColor: {r: 0.9607843, g: 0.84313726, b: 0.43137255, a: 1}
